# Copia este archivo a .env (que está en .gitignore, nunca se versiona)
# y rellena tu API key real.

# Groq (https://console.groq.com/keys) -- usada por src/llm_explainer.py
# para la pestaña "Explicador (IA)" del dashboard. Sin esta variable, esa
# pestaña muestra un aviso pero el resto del dashboard funciona igual.
GROQ_API_KEY=
