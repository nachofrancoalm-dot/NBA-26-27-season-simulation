# Copia este archivo a .env (que está en .gitignore, nunca se versiona)
# y rellena tu API key real.

# Groq (https://console.groq.com/keys) -- usada por src/llm_explainer.py
# para la pestaña "Explicador (IA)" del dashboard. Sin esta variable, esa
# pestaña muestra un aviso pero el resto del dashboard funciona igual.
GROQ_API_KEY=

# Tavily (https://tavily.com) -- opcional, usada por src/news_search.py
# para el botón "Buscar noticias recientes" dentro del Explicador (fase 2
# del RAG de noticias). Sin esta variable, ese botón avisa pero se puede
# seguir pegando texto de noticias a mano (fase 1, no requiere API key).
TAVILY_API_KEY=
